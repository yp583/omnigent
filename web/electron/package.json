{
  "name": "omnigent-desktop-electron",
  "productName": "Omnigent Personal",
  "version": "0.10.0-dev.0",
  "description": "Isolated personal Omnigent desktop client with a locally packaged frontend.",
  "private": true,
  "main": "src/main.js",
  "homepage": "https://omnigent.ai",
  "repository": {
    "type": "git",
    "url": "https://github.com/omnigent-ai/omnigent.git"
  },
  "author": {
    "name": "Databricks, Inc.",
    "email": "support@omnigent.ai"
  },
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "test": "node --test",
    "build": "electron-builder",
    "build:mac": "electron-builder --mac",
    "build:mac:release": "electron-builder --mac -c.mac.notarize=true",
    "build:linux": "electron-builder --linux",
    "build:win": "electron-builder --win",
    "build:overlay": "pnpm --filter web run build:overlay",
    "predev": "pnpm run build:web && pnpm run build:overlay",
    "prestart": "pnpm run build:web && pnpm run build:overlay",
    "build:web": "pnpm --filter web run build",
    "prebuild": "pnpm run build:web && pnpm run build:overlay",
    "prebuild:mac": "pnpm run build:web && pnpm run build:overlay",
    "prebuild:mac:release": "pnpm run build:web && pnpm run build:overlay",
    "prebuild:linux": "pnpm run build:web && pnpm run build:overlay",
    "prebuild:win": "pnpm run build:web && pnpm run build:overlay"
  },
  "devDependencies": {
    "electron": "^42.3.2",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "ai.omnigent.desktop.personal",
    "productName": "Omnigent Personal",
    "directories": {
      "output": "dist"
    },
    "protocols": [
      {
        "name": "Omnigent Personal session link",
        "schemes": [
          "omnigent-personal"
        ]
      }
    ],
    "afterPack": "build/afterPack.js",
    "files": [
      "src/**/*",
      "setup/**/*",
      "find/**/*",
      "icons/**/*",
      "overlay/**/*"
    ],
    "extraResources": [
      {
        "from": "../platform-assets",
        "to": "platform-assets",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../../omnigent/server/static/web-ui",
        "to": "web-ui",
        "filter": [
          "**/*"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "icons/icon.icns",
      "artifactName": "${productName}-${version}-${arch}-mac.${ext}",
      "identity": null,
      "hardenedRuntime": true,
      "entitlements": "signing/entitlements.mac.plist",
      "entitlementsInherit": "signing/entitlements.mac.inherit.plist",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Omnigent uses the microphone for voice dictation in the message composer.",
        "CFBundleIconName": "AppIcon"
      },
      "gatekeeperAssess": false,
      "notarize": false,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "dmg": {
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "background": "dmg/background.tiff",
      "window": {
        "width": 640,
        "height": 465
      },
      "iconSize": 96,
      "contents": [
        {
          "x": 170,
          "y": 100
        },
        {
          "x": 470,
          "y": 100,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "linux": {
      "icon": "icons/icon.png",
      "category": "Development",
      "maintainer": "Databricks, Inc. <support@omnigent.ai>",
      "target": [
        "AppImage",
        "deb"
      ]
    },
    "win": {
      "icon": "icons/icon.ico",
      "target": [
        "nsis"
      ]
    }
  },
  "dependencies": {
    "electron-updater": "^6.3.9",
    "http-proxy": "^1.18.1",
    "js-yaml": "^4.3.0"
  }
}
